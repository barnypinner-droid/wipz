{
  "expo": {
    "name": "Wipz",
    "slug": "wipz",
    "version": "1.0.0",
    "scheme": "wipz",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wipzapp.wipz"
    },
    "android": {
      "package": "com.wipzapp.wipz",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "525812b8-ee3d-4aa2-a1ed-b39772aa5302"
      }
    },
    "owner": "wipz",
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Wipz to use Face ID to unlock the app."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Wipz to access your contacts so you can add or invite people to a wip."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wipz to access your photos so you can set a profile picture."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.wipzapp.wipz",
          "enableGooglePay": true
        }
      ]
    ]
  }
}
